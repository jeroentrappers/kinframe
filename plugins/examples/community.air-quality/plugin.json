{
  "id": "community.air-quality",
  "name": "Air quality",
  "version": "0.1.0",
  "api": 1,
  "author": { "name": "kinframe example" },
  "license": "Apache-2.0",
  "description": "The European Air Quality Index and fine dust where you live, from Open-Meteo. An example plugin.",
  "refresh": { "min_seconds": 600, "default_seconds": 1800 },
  "permissions": { "http": ["https://air-quality-api.open-meteo.com"] },
  "settings": [
    { "key": "latitude", "type": "number", "label": "Latitude", "required": true },
    { "key": "longitude", "type": "number", "label": "Longitude", "required": true }
  ]
}
