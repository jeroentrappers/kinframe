{
  "id": "community.bin-calendar",
  "name": "Bin day",
  "version": "0.1.0",
  "api": 1,
  "author": { "name": "kinframe example" },
  "license": "Apache-2.0",
  "description": "Which bins go out today or tomorrow, from your municipality's waste calendar (an iCal link). An example plugin.",
  "refresh": { "min_seconds": 3600, "default_seconds": 21600 },
  "permissions": { "http": ["settings.calendar_url"] },
  "settings": [
    { "key": "calendar_url", "type": "url", "label": "Waste calendar (iCal link)", "required": true }
  ]
}
