{
  "id": "kinframe.ha-ev",
  "name": "Car battery (Home Assistant)",
  "version": "1.0.0",
  "api": 1,
  "author": { "name": "kinframe", "url": "https://github.com/jeroentrappers/kinframe" },
  "license": "Apache-2.0",
  "description": "An electric car's charge, range and charging state from Home Assistant; also any battery with a level sensor.",
  "slots": ["top-left", "top-right"],
  "refresh": { "min_seconds": 5, "default_seconds": 60, "stale_seconds": 21600 },
  "permissions": { "http": ["settings.base_url"], "websocket": ["settings.base_url"] },
  "settings": [
    { "key": "base_url", "type": "url", "label": "Home Assistant address", "required": true, "local_only": true, "discover": "_home-assistant._tcp" },
    { "key": "token", "type": "secret", "label": "Long-lived access token", "required": true },
    { "key": "name", "type": "text", "label": "Name", "placeholder": "EV3" },
    { "key": "prefix", "type": "text", "label": "Entity prefix (Kia/Hyundai)", "placeholder": "ev3",
      "help": "Kia Connect / Hyundai Bluelink: the start of the car's entity names; the sensors below are then found by name." },
    { "key": "battery_level", "type": "entity", "label": "Battery level", "domain": "sensor", "unit": "%" },
    { "key": "range", "type": "entity", "label": "Range", "domain": "sensor" },
    { "key": "charging", "type": "entity", "label": "Charging", "domain": "binary_sensor" },
    { "key": "plugged", "type": "entity", "label": "Plugged in", "domain": "binary_sensor" },
    { "key": "charge_minutes", "type": "entity", "label": "Time to full (minutes)", "domain": "sensor" },
    { "key": "charge_power", "type": "entity", "label": "Charging power", "domain": "sensor" },
    { "key": "updated", "type": "entity", "label": "Last update from the car (timestamp)", "domain": "sensor" }
  ],
  "presets": [
    { "id": "kia_hyundai", "label": "Kia / Hyundai (Kia Connect, Bluelink)",
      "settings": {
        "battery_level": "sensor.{prefix}_ev_battery_level", "range": "sensor.{prefix}_ev_range",
        "charging": "binary_sensor.{prefix}_ev_battery_charge", "plugged": "binary_sensor.{prefix}_ev_battery_plug",
        "charge_minutes": "sensor.{prefix}_estimated_charge_duration", "updated": "sensor.{prefix}_last_updated_at"
      } }
  ]
}
