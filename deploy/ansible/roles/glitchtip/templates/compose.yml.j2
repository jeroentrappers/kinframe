# Managed by Ansible (kinframe role glitchtip). GlitchTip: crash and error reports (docs/spec/crash-reporting.md).
# It accepts the Sentry SDKs' reports, so nothing goes to a third party.
name: glitchtip

x-environment: &env
  DATABASE_URL: postgres://glitchtip:{{ glitchtip_db_password | urlencode }}@postgres:5432/glitchtip
  VALKEY_URL: redis://valkey:6379
  SECRET_KEY: "{{ glitchtip_secret_key }}"
  EMAIL_URL: "{{ glitchtip_email_url }}"
  DEFAULT_FROM_EMAIL: "{{ glitchtip_from_email }}"
  GLITCHTIP_DOMAIN: https://{{ glitchtip_domain }}
  ALLOWED_HOSTS: "{{ glitchtip_domain }},127.0.0.1,localhost"
  ENABLE_USER_REGISTRATION: "False"
  ENABLE_ORGANIZATION_CREATION: "False"
  ENABLE_ADMIN: "False"
  GLITCHTIP_MAX_EVENT_LIFE_DAYS: "{{ glitchtip_event_days }}"
  GLITCHTIP_ENABLE_UPTIME: "False"
  GLITCHTIP_ENABLE_LOGS: "False"

services:
  postgres:
    image: postgres:{{ glitchtip_postgres_version }}
    # GlitchTip's partitioned tables need more locks than the default.
    command: -c max_locks_per_transaction=512
    restart: unless-stopped
    environment:
      POSTGRES_USER: glitchtip
      POSTGRES_DB: glitchtip
      POSTGRES_PASSWORD: "{{ glitchtip_db_password }}"
    volumes: [ "pg-data:/var/lib/postgresql" ]
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U glitchtip" ]
      interval: 10s
      retries: 10

  valkey:
    image: valkey/valkey:{{ glitchtip_valkey_version }}
    restart: unless-stopped

  web:
    image: glitchtip/glitchtip:{{ glitchtip_version }}
    depends_on:
      postgres: { condition: service_healthy }
      valkey: { condition: service_started }
    restart: unless-stopped
    environment:
      <<: *env
      SERVER_ROLE: all_in_one
    ports: [ "127.0.0.1:{{ glitchtip_port }}:8000" ]
    volumes: [ "uploads:/code/uploads" ]
    mem_limit: {{ glitchtip_mem_limit }}

volumes:
  pg-data: {}
  uploads: {}
