# Managed by Ansible (kinframe role). Contains secrets: mode 0600.
KINFRAME_ENV=production
KINFRAME_PUBLIC_URL=https://{{ kinframe_domain }}
KINFRAME_SERVER_NAME={{ kinframe_server_name }}
KINFRAME_VERSION={{ kinframe_version }}
KINFRAME_LOG_LEVEL={{ kinframe_log_level }}
KINFRAME_DATABASE_URL=postgres://kinframe:{{ kinframe_db_password | urlencode }}@postgres:5432/kinframe?sslmode=disable
KINFRAME_SIGNING_KEY={{ kinframe_signing_key }}

# Logto: tokens are issued for the public issuer; keys are fetched over the compose network.
KINFRAME_OIDC_ISSUER=https://{{ logto_domain }}/oidc
KINFRAME_OIDC_JWKS_URL=http://logto:3001/oidc/jwks

# Mail for Logto sign-in codes (used by bootstrap-logto to configure Logto's SMTP connector).
KINFRAME_SMTP_HOST={{ kinframe_smtp_host }}
KINFRAME_SMTP_PORT={{ kinframe_smtp_port }}
KINFRAME_SMTP_USER={{ kinframe_smtp_user }}
KINFRAME_SMTP_PASSWORD={{ kinframe_smtp_password }}
KINFRAME_SMTP_FROM={{ kinframe_smtp_from }}

{% if kinframe_shop %}
# Pre-order shop (rendered from kinframe_shop).
KINFRAME_SHOP_FILE=/etc/kinframe/shop.json
{% endif %}

# Media storage. The S3 settings are also written while the backend is still fs (bundled object store
# enabled), so `kinframe-server migrate-blobs --from fs --to s3` can run inside the server container.
KINFRAME_BLOB_BACKEND={{ kinframe_blob_backend }}
KINFRAME_MEDIA_REDIRECT={{ kinframe_media_redirect }}
{% if kinframe_minio or kinframe_blob_backend == 's3' %}
{% if kinframe_minio %}
KINFRAME_S3_ENDPOINT=http://minio:9000
KINFRAME_S3_USE_SSL=false
KINFRAME_S3_PATH_STYLE=true
# The bootstrap job creates the bucket; kinframe's key may not create buckets.
KINFRAME_S3_CREATE_BUCKET=false
{% else %}
KINFRAME_S3_ENDPOINT={{ kinframe_s3_endpoint }}
KINFRAME_S3_USE_SSL={{ kinframe_s3_use_ssl | bool | lower }}
KINFRAME_S3_PATH_STYLE={{ kinframe_s3_path_style | bool | lower }}
KINFRAME_S3_CREATE_BUCKET=false
{% endif %}
{% if kinframe_s3_public_endpoint %}
KINFRAME_S3_PUBLIC_ENDPOINT={{ kinframe_s3_public_endpoint }}
{% endif %}
KINFRAME_S3_REGION={{ kinframe_s3_region }}
KINFRAME_S3_BUCKET={{ kinframe_s3_bucket }}
KINFRAME_S3_PREFIX={{ kinframe_s3_prefix }}
KINFRAME_S3_ACCESS_KEY={{ kinframe_s3_access_key }}
KINFRAME_S3_SECRET_KEY={{ kinframe_s3_secret_key }}
{% endif %}
{% for k, v in kinframe_extra_env.items() %}
{{ k }}={{ v }}
{% endfor %}
