# Managed by Ansible (kinframe role). Contains secrets: mode 0600.
KINFRAME_ENV=production
KINFRAME_PUBLIC_URL=https://{{ kinframe_domain }}
KINFRAME_SERVER_NAME={{ kinframe_server_name }}
KINFRAME_VERSION={{ kinframe_version }}
KINFRAME_LOG_LEVEL={{ kinframe_log_level }}
KINFRAME_DATABASE_URL=postgres://kinframe:{{ kinframe_db_password | urlencode }}@postgres:5432/kinframe?sslmode=disable
KINFRAME_SIGNING_KEY={{ kinframe_signing_key }}

# Logto: tokens are issued for the public issuer; keys are fetched over the compose network.
KINFRAME_OIDC_ISSUER=https://{{ logto_domain }}/oidc
KINFRAME_OIDC_JWKS_URL=http://logto:3001/oidc/jwks

# Mail for Logto sign-in codes (used by bootstrap-logto to configure Logto's SMTP connector).
KINFRAME_SMTP_HOST={{ kinframe_smtp_host }}
KINFRAME_SMTP_PORT={{ kinframe_smtp_port }}
KINFRAME_SMTP_USER={{ kinframe_smtp_user }}
KINFRAME_SMTP_PASSWORD={{ kinframe_smtp_password }}
KINFRAME_SMTP_FROM={{ kinframe_smtp_from }}
{% for k, v in kinframe_extra_env.items() %}
{{ k }}={{ v }}
{% endfor %}
