-- Managed by Ansible (kinframe role). Runs once, when the Postgres volume is first initialised.
CREATE ROLE kinframe LOGIN PASSWORD '{{ kinframe_db_password | replace("'", "''") }}';
CREATE DATABASE kinframe OWNER kinframe;
-- Logto's `db seed` creates per-tenant roles, so its role needs CREATEROLE.
CREATE ROLE logto LOGIN CREATEROLE PASSWORD '{{ logto_db_password | replace("'", "''") }}';
CREATE DATABASE logto OWNER logto;
