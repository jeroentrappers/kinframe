# Managed by Ansible (kinframe role). Do not edit on the box.
# All listeners are bound to loopback; a reverse proxy terminates TLS in front.
name: kinframe

services:
  postgres:
    image: postgres:{{ postgres_version }}
    container_name: kinframe-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD_FILE: /run/kinframe/postgres-password
      POSTGRES_DB: postgres
    volumes:
      - pgdata:/var/lib/postgresql/data
      # Creates the kinframe and logto roles + databases on first start only.
      - ./initdb:/docker-entrypoint-initdb.d:ro
      - ./secrets/postgres-password:/run/kinframe/postgres-password:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 24

  logto:
    image: svhd/logto:{{ logto_version }}
    container_name: kinframe-logto
    restart: unless-stopped
    depends_on:
      postgres: { condition: service_healthy }
    # `db seed --swe` initialises the schema on the first run and skips it afterwards.
    entrypoint: ["sh", "-c", "npm run cli db seed -- --swe && npm start"]
    env_file: ./logto.env
    ports:
      - "127.0.0.1:{{ logto_core_port }}:3001"
      - "127.0.0.1:{{ logto_admin_port }}:3002"

  # One-shot Logto setup (resource, apps, roles, SMTP, sign-in experience). Run by Ansible with
  # `docker compose run --rm logto-bootstrap`; the profile keeps `up -d` from starting it.
  logto-bootstrap:
    image: {{ kinframe_image }}:{{ kinframe_version }}
    profiles: [bootstrap]
    command: ["bootstrap-logto"]
    restart: "no"
    depends_on:
      logto: { condition: service_started }
    env_file: [./kinframe.env, ./bootstrap.env]
    volumes:
      - media:/data

{% if kinframe_minio %}
  # S3-compatible object store for media (Silo, the maintained MinIO fork). Reachable only on the compose
  # network; the console is published on loopback only when kinframe_minio_console_port is set.
  minio:
    image: {{ kinframe_minio_image }}:{{ kinframe_minio_version }}
    container_name: kinframe-minio
    restart: unless-stopped
    command: ["server", "/data", "--console-address", ":9001"]
    env_file: ./minio.env
    volumes:
      - miniodata:/data
{% if (kinframe_minio_console_port | int) > 0 %}
    ports:
      - "127.0.0.1:{{ kinframe_minio_console_port }}:9001"
{% endif %}
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:9000/minio/health/live"]
      interval: 10s
      timeout: 5s
      retries: 12

  # One-shot: bucket, least-privilege policy and kinframe's user. Run by Ansible with
  # `docker compose run --rm minio-bootstrap`.
  minio-bootstrap:
    image: {{ kinframe_minio_image }}:{{ kinframe_minio_version }}
    profiles: [bootstrap]
    entrypoint: ["/bin/sh", "/bootstrap/minio-bootstrap.sh"]
    restart: "no"
    depends_on:
      minio: { condition: service_healthy }
    env_file: ./minio.env
    volumes:
      - ./minio-bootstrap.sh:/bootstrap/minio-bootstrap.sh:ro

{% endif %}
  server:
    image: {{ kinframe_image }}:{{ kinframe_version }}
    container_name: kinframe-server
    restart: unless-stopped
    # One file descriptor per websocket (every frame stays connected): Docker's default of 1024 caps it too low.
    ulimits:
      nofile: { soft: 65536, hard: 65536 }
    depends_on:
      postgres: { condition: service_healthy }
      logto: { condition: service_started }
{% if kinframe_minio %}
      minio: { condition: service_healthy }
{% endif %}
    env_file: ./kinframe.env
    volumes:
      - media:/data
    ports:
      - "127.0.0.1:{{ kinframe_port }}:8110"

volumes:
  pgdata:
  media:
{% if kinframe_minio %}
  miniodata:
{% endif %}
