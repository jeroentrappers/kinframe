# Managed by Ansible (kinframe role). Only for the logto-bootstrap job. Contains secrets: mode 0600.
KINFRAME_LOGTO_ENDPOINT=https://{{ logto_domain }}
KINFRAME_LOGTO_URL=http://logto:3001
KINFRAME_LOGTO_ADMIN_ENDPOINT=https://{{ logto_admin_domain }}
KINFRAME_LOGTO_ADMIN_URL=http://logto:3002
KINFRAME_LOGTO_ADMIN_USERNAME={{ logto_admin_username }}
KINFRAME_LOGTO_ADMIN_PASSWORD={{ logto_admin_password }}
KINFRAME_OPERATOR_EMAILS={{ kinframe_operator_emails | join(',') }}

# Social sign-in (a provider is off while its client ID is empty).
KINFRAME_SOCIAL_APPLE_CLIENT_ID={{ kinframe_social_apple_client_id }}
KINFRAME_SOCIAL_GOOGLE_CLIENT_ID={{ kinframe_social_google_client_id }}
KINFRAME_SOCIAL_GOOGLE_CLIENT_SECRET={{ kinframe_social_google_client_secret }}
KINFRAME_SOCIAL_MICROSOFT_CLIENT_ID={{ kinframe_social_microsoft_client_id }}
KINFRAME_SOCIAL_MICROSOFT_CLIENT_SECRET={{ kinframe_social_microsoft_client_secret }}
KINFRAME_SOCIAL_MICROSOFT_TENANT={{ kinframe_social_microsoft_tenant }}
KINFRAME_SOCIAL_FACEBOOK_CLIENT_ID={{ kinframe_social_facebook_client_id }}
KINFRAME_SOCIAL_FACEBOOK_CLIENT_SECRET={{ kinframe_social_facebook_client_secret }}
KINFRAME_SOCIAL_GITHUB_CLIENT_ID={{ kinframe_social_github_client_id }}
KINFRAME_SOCIAL_GITHUB_CLIENT_SECRET={{ kinframe_social_github_client_secret }}
KINFRAME_SOCIAL_REMOVE_UNCONFIGURED={{ kinframe_social_remove_unconfigured | bool | lower }}
KINFRAME_SOCIAL_LINK_BY_EMAIL={{ kinframe_social_link_by_email | bool | lower }}

# Sign-in page look and legal links.
KINFRAME_LOGTO_BRANDING={{ kinframe_logto_branding | bool | lower }}
KINFRAME_TERMS_URL={{ kinframe_terms_url }}
KINFRAME_PRIVACY_URL={{ kinframe_privacy_url }}
