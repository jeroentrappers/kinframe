# Managed by Ansible (kinframe role). Bundled object store (Silo/MinIO) and its bootstrap job.
# Contains secrets: mode 0600.
MINIO_ROOT_USER={{ kinframe_minio_root_user }}
MINIO_ROOT_PASSWORD={{ kinframe_minio_root_password }}
MINIO_BROWSER={{ 'on' if (kinframe_minio_console_port | int) > 0 else 'off' }}
# Only read by minio-bootstrap: the bucket and kinframe's least-privilege user.
KINFRAME_S3_BUCKET={{ kinframe_s3_bucket }}
KINFRAME_S3_PREFIX={{ kinframe_s3_prefix }}
KINFRAME_S3_ACCESS_KEY={{ kinframe_s3_access_key }}
KINFRAME_S3_SECRET_KEY={{ kinframe_s3_secret_key }}
