<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.kinframe.mictest"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- targetSdk 22 keeps RECORD_AUDIO an install-time permission, so no prompt on the frame. -->
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="22" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application android:label="kinframe mic test" android:allowBackup="false">
        <activity android:name=".MicTestActivity" android:exported="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
    </application>
</manifest>
