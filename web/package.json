    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@logto/browser": "^3.1.1",
    "openapi-fetch": "^0.17.0",
    "tus-js-client": "^4.3.1"
  }
