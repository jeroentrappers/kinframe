# Copy to .env (git-ignored) and adjust. Placeholders only; never commit real values.
KINFRAME_ENV=development
KINFRAME_PUBLIC_URL=http://localhost:8110
KINFRAME_DATABASE_URL=postgres://kinframe:change-me@127.0.0.1:5433/kinframe?sslmode=disable
KINFRAME_DEV_AUTH=1
# 32+ random bytes, hex or base64 (e.g. `openssl rand -hex 32`). Required in production;
# in development a key is generated into the data dir when unset.
# KINFRAME_SIGNING_KEY=change-me
# Logto (production):
# KINFRAME_OIDC_ISSUER=https://auth.example.org/oidc
# KINFRAME_OIDC_AUDIENCE=https://frames.example.org/v1
# KINFRAME_OIDC_WEB_CLIENT_ID=change-me
# KINFRAME_OIDC_MOBILE_CLIENT_ID=change-me
# Or let `kinframe-server bootstrap-logto` write them to $KINFRAME_DATA_DIR/logto.json (see README).
# bootstrap-logto (one-shot job):
# KINFRAME_LOGTO_ENDPOINT=https://auth.example.org
# KINFRAME_LOGTO_URL=http://logto:3001
# KINFRAME_LOGTO_ADMIN_ENDPOINT=https://admin.auth.example.org
# KINFRAME_LOGTO_ADMIN_URL=http://logto:3002
# KINFRAME_LOGTO_ADMIN_USERNAME=change-me
# KINFRAME_LOGTO_ADMIN_PASSWORD=change-me
# KINFRAME_LOGTO_M2M_ID=change-me
# KINFRAME_LOGTO_M2M_SECRET=change-me
# KINFRAME_OPERATOR_EMAILS=you@example.org
# KINFRAME_SMTP_HOST=smtp.example.org
# KINFRAME_SMTP_PORT=587
# KINFRAME_SMTP_USER=change-me
# KINFRAME_SMTP_PASSWORD=change-me
# KINFRAME_SMTP_FROM=kinframe <noreply@example.org>
