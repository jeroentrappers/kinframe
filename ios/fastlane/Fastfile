# Signing and App Store uploads for the iOS app. Run from ios/: `bundle exec fastlane <lane>`.
#
# Needs an App Store Connect API key (ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH, read from ~/.appstoreconnect/env when
# not set) and MATCH_PASSWORD. Signing identities go into a dedicated keychain (KINFRAME_KEYCHAIN, default
# ~/Library/Keychains/kinframe-signing.keychain-db, password KINFRAME_KEYCHAIN_PASSWORD), or a temporary one on CI.
default_platform(:ios)

APP_IDS = ["app.kinframe.family", "app.kinframe.family.share"].freeze

platform :ios do
  before_all do
    load_local_env
    setup_ci if ENV["CI"]
  end

  desc "Fetch the development and App Store certificates and profiles (read-only)"
  lane :certificates do
    sync(type: "development")
    sync(type: "appstore")
  end

  desc "Create missing certificates and profiles (changes the Apple account; ask first)"
  lane :renew_certificates do
    sync(type: "development", readonly: false)
    sync(type: "appstore", readonly: false)
  end

  desc "Regenerate the profiles after a capability change on the App ID (changes the Apple account; ask first)"
  lane :refresh_profiles do
    sync(type: "development", readonly: false, force: true)
    sync(type: "appstore", readonly: false, force: true)
  end

  desc "Register a development device and add it to the development profiles: name:… udid:…"
  lane :register_device do |options|
    register_devices(devices: { options.fetch(:name) => options.fetch(:udid) }, api_key: asc_key)
    sync(type: "development", readonly: false, force_for_new_devices: true)
  end

  desc "Archive a Release build for the App Store into build/; upload: true also sends it to TestFlight"
  lane :release do |options|
    smoke_test
    sync(type: "appstore")
    version = ENV["MARKETING_VERSION"] || last_tag_version
    build = ENV["BUILD_NUMBER"] || sh("git rev-list --count HEAD").strip
    UI.message("Kinframe #{version} (#{build})")
    build_app(
      project: "Kinframe.xcodeproj",
      scheme: "Kinframe",
      configuration: "Release",
      output_directory: "build",
      export_options: "ExportOptions.plist",
      xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build}"
    )
    upload_to_testflight(api_key: asc_key, skip_waiting_for_build_processing: true) if options[:upload]
  end

  desc "Upload the store listing (metadata/, screenshots/) to App Store Connect. Never submits for review."
  lane :store_listing do |options|
    deliver(
      api_key: asc_key,
      skip_metadata: options[:skip_metadata] || false,
      skip_screenshots: options[:skip_screenshots] || false,
      app_review_information: review_information,
    )
  end

  desc "Submit build_number (waits for processing) for App Review with the current listing. Released automatically after approval."
  lane :submit do |options|
    deliver(
      api_key: asc_key,
      build_number: options.fetch(:build_number).to_s,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      submission_information: { add_id_info_uses_idfa: false, export_compliance_uses_encryption: false },
      app_review_information: review_information,
    )
  end

  desc "Fetch the Mac Catalyst App Store certificates and profiles (read-only)"
  lane :mac_certificates do
    sync(type: "appstore", platform: "catalyst")
  end

  desc "Create the Mac Catalyst App Store profiles and the Mac installer certificate (changes the Apple account; ask first)"
  lane :mac_renew_certificates do
    sync(type: "appstore", platform: "catalyst", readonly: false)
  end

  desc "Archive the Mac Catalyst build for the Mac App Store into build/mac; upload: true also sends it to App Store Connect"
  lane :mac_release do |options|
    smoke_test(platform: "mac")
    sync(type: "appstore", platform: "catalyst")
    version = ENV["MARKETING_VERSION"] || last_tag_version
    build = ENV["BUILD_NUMBER"] || sh("git rev-list --count HEAD").strip
    UI.message("Kinframe for Mac #{version} (#{build})")
    build_app(
      project: "Kinframe.xcodeproj",
      scheme: "Kinframe",
      configuration: "Release",
      catalyst_platform: "macos",
      destination: "generic/platform=macOS,variant=Mac Catalyst",
      output_directory: "build/mac",
      installer_cert_name: installer_identity,
      export_options: "ExportOptions-Mac.plist",
      xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build}"
    )
    upload_to_testflight(api_key: asc_key, app_platform: "osx", pkg: Dir["build/mac/*.pkg"].first,
                         skip_waiting_for_build_processing: true) if options[:upload]
  end

  desc "Smoke test: the signed-in app opens every screen against a fake server without crashing (KinframeTests/SmokeTests)."
  desc "platform: \"mac\" runs it as Mac Catalyst; SMOKE_SIMULATOR picks the simulator. No signing. Runs before release, mac_release."
  lane :smoke_test do |options|
    destination = if options[:platform] == "mac"
      "platform=macOS,variant=Mac Catalyst"
    else
      "platform=iOS Simulator,name=#{ENV["SMOKE_SIMULATOR"] || smoke_simulator}"
    end
    run_tests(
      project: "Kinframe.xcodeproj",
      scheme: "Kinframe",
      destination: destination,
      only_testing: ["KinframeTests/SmokeTests"],
      xcargs: "CODE_SIGNING_ALLOWED=NO",
      # The unsigned Mac test host hung at launch (in dyld, opening its frameworks) when built on an external volume,
      # so its build goes to the start disk.
      derived_data_path: options[:platform] == "mac" ? File.expand_path("~/Library/Caches/kinframe-smoke") : nil,
      output_directory: "build/smoke",
      output_types: "junit",
      skip_slack: true
    )
  end

  private_lane :sync do |options|
    match(
      type: options[:type],
      platform: options.fetch(:platform, "ios"),
      additional_cert_types: options[:platform] == "catalyst" ? ["mac_installer_distribution"] : nil,
      readonly: options.fetch(:readonly, true),
      force_for_new_devices: options.fetch(:force_for_new_devices, false),
      force: options.fetch(:force, false),
      api_key: asc_key,
      keychain_name: ENV["CI"] ? nil : keychain_path,
      keychain_password: ENV["CI"] ? nil : ENV.fetch("KINFRAME_KEYCHAIN_PASSWORD")
    )
  end
end

# App Review contact and demo account: fastlane/review_information/*.txt plus REVIEW_PASSWORD and REVIEW_PHONE
# (+32 …) from ~/.appstoreconnect/review.env. Without a phone number Apple rejects it, so it is left out.
def review_information
  return {} if ENV["REVIEW_PHONE"].to_s.empty?
  dir = File.expand_path("review_information", __dir__)
  info = Dir[File.join(dir, "*.txt")].to_h { |f| [File.basename(f, ".txt").to_sym, File.read(f).strip] }
  info.merge(phone_number: ENV["REVIEW_PHONE"], demo_password: ENV.fetch("REVIEW_PASSWORD"), demo_required: true)
end

def asc_key
  @asc_key ||= app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH")
  )
end

def keychain_path
  ENV["KINFRAME_KEYCHAIN"] || File.expand_path("~/Library/Keychains/kinframe-signing.keychain-db")
end

# ~/.appstoreconnect/env (API key) and ~/.appstoreconnect/signing.env (MATCH_PASSWORD, KINFRAME_KEYCHAIN_PASSWORD):
# KEY=value lines; variables already set win.
def load_local_env
  %w[env signing.env review.env].each do |name|
    path = File.expand_path("~/.appstoreconnect/#{name}")
    next unless File.exist?(path)
    File.readlines(path).each do |line|
      key, value = line.strip.split("=", 2)
      next if key.nil? || key.start_with?("#") || value.nil?
      ENV[key] ||= value.gsub("$HOME", Dir.home)
    end
  end
end

# The latest vX.Y.Z tag without its pre-release suffix (App Store versions are numbers only).
def last_tag_version
  tag = sh("git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null || echo v0.1.0").strip
  tag.delete_prefix("v").split("-").first
end

# An available iPhone simulator for the smoke test, a booted one first.
def smoke_simulator
  devices = JSON.parse(sh("xcrun simctl list devices available -j", log: false))["devices"].values.flatten
  phones = devices.select { |d| d["name"].include?("iPhone") }
  phone = phones.find { |d| d["state"] == "Booted" } || phones.last
  UI.user_error!("No iPhone simulator for the smoke test; set SMOKE_SIMULATOR") unless phone
  phone["name"]
end

# The "3rd Party Mac Developer Installer" identity match put in the signing keychain (signs the Mac .pkg).
def installer_identity
  out = `security find-identity -v #{ENV["CI"] ? "" : keychain_path.shellescape} 2>/dev/null`
  out[/"(3rd Party Mac Developer Installer: [^"]+)"/, 1] || out[/"(Mac Installer Distribution: [^"]+)"/, 1] ||
    UI.user_error!("No Mac installer certificate; run mac_certificates")
end
