          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent er al bij"
          }
        }
      }
    },
    "add.another": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add another frame"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog een kader toevoegen"
          }
        }
      }
