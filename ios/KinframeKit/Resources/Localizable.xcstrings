        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send photos from your phone and they appear on the frame within seconds. Easy for grandma and grandpa, and no subscription."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur foto’s vanaf je smartphone en binnen enkele seconden staan ze op het kader. Eenvoudig voor oma en opa, en zonder abonnement."
          }
        }
      }
    },
    "storefront.metaDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send photos from your phone and they appear on the frame within seconds. Easy for grandma and grandpa, no subscription. Reserve now, pay later."
          }
        },
        "nl": {
          "stringUnit": {
