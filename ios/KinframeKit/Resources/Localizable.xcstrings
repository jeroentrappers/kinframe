        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In Telegram: open de groep, Groepsinfo → Beheerders → Toevoegen, en kies de bot. Hij heeft geen rechten nodig; je mag ze allemaal uitvinken."
