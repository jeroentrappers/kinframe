    "account.delete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Account verwijderen"
          }
        }
      }
    },
    "account.deleteBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account, profile photo and sign-in are deleted for good, and you leave all your frames. This can’t be undone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account, je profielfoto en je aanmelding worden voorgoed verwijderd, en je verlaat al je kaders. Dit kan niet ongedaan worden gemaakt."
          }
        }
      }
    },
    "account.deleteItems": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also remove the photos and videos I sent"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ook de foto’s en video’s verwijderen die ik stuurde"
          }
        }
      }
    },
    "account.deleteItemsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Otherwise they stay on the frames, with your name."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anders blijven ze op de kaders staan, met je naam."
          }
        }
      }
    },
    "account.deleteOwner": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You own {frames}. Hand each frame over to another member, or remove it, before you delete your account."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij bent eigenaar van {frames}. Geef elk kader aan een ander lid of verwijder het voor je je account verwijdert."
          }
        }
      }
    },
    "account.deleteTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your account?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account verwijderen?"
          }
        }
      }
    },
    "account.deleted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account has been deleted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account is verwijderd."
          }
        }
      }
    },
    "add.alreadyBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re already a member of {name}."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent al lid van {name}."
          }
        }
      }
    },
