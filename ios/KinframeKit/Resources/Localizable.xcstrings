      }
    },
    "sources.err.format_changed_icloud": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud answered in a way we don’t understand. This can happen because Apple offers no official way to do this. We’ll keep checking once a day."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud gaf een antwoord dat we niet begrijpen. Dat kan gebeuren omdat Apple hier geen officiële manier voor biedt. We blijven het één keer per dag proberen."
          }
        }
      }
    },
