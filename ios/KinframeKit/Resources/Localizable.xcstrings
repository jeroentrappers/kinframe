    "ios.ps.emptyAlbum": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this album in sync with an album in Immich or iCloud: new photos appear on the frame by themselves."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd dit album gelijk met een album in Immich of iCloud: nieuwe foto’s verschijnen vanzelf op het kader."
          }
        }
      }
    },
    "ios.ps.emptyFeed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post the photos of an Immich or iCloud album to this family automatically."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Post de foto’s van een Immich- of iCloud-album automatisch in deze familie."
          }
        }
      }
    },
    "ios.ps.emptyMine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven’t connected any albums yet. Open an album or a family to sync it from Immich or iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt nog geen albums gekoppeld. Open een album of een familie om het vanuit Immich of iCloud te synchroniseren."
          }
        }
      }
    },
    "ios.ps.err.album_not_found": {
      "extractionState": "manual",
      "localizations": {
