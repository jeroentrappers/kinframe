      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocking hides someone’s comments and messages for you and stops their messages. You stay in the same families."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je iemand blokkeert, zie je diens opmerkingen en berichten niet meer en kan die persoon je geen berichten meer sturen. Jullie blijven in dezelfde families."
          }
        }
      }
    },
