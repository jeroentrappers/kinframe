    "ios.tg.explainGroupFeed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos posted in the group are posted to {name}. Everyone in the group can send. Telegram asks which group; the bot joins and says hello once."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s die in de groep gepost worden, komen in {name}. Iedereen in de groep kan sturen. Telegram vraagt welke groep; de bot komt erbij en zegt één keer hallo."
          }
        }
      }
    },
    "ios.tg.explainGroupFrame": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos posted in the group appear on {name}. Everyone in the group can send. Telegram asks which group; the bot joins and says hello once."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s die in de groep gepost worden, verschijnen op {name}. Iedereen in de groep kan sturen. Telegram vraagt welke groep; de bot komt erbij en zegt één keer hallo."
          }
        }
      }
    },
    "ios.tg.explainInvite": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share this link with someone without the app. They tap it and Start; what they send the bot goes to {name} in your name."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel deze link met iemand zonder de app. Die tikt erop en op Start; wat die naar de bot stuurt, gaat in jouw naam naar {name}."
          }
        }
      }
    },
    "ios.tg.explainMine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a chat with the bot in your Telegram and links it to your account. Whatever you send the bot goes to {name}, as you."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent een chat met de bot in je Telegram en koppelt die aan je account. Wat je naar de bot stuurt, gaat naar {name}, op jouw naam."
          }
        }
      }
    },
