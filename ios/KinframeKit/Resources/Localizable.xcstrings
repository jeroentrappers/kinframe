    "add.convertHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have a Denver photo frame with the Frameo app? You can turn it into a kinframe frame."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb je een Denver-fotokader met de Frameo-app? Dan kun je er een kinframe-kader van maken."
          }
        }
      }
    },
