            "state": "translated",
            "value": "Zie de glimlach"
          }
        }
      }
    },
    "landing.f3Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source and self-hosted, with no telemetry. Every photo is safe on your own server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source, zelf te hosten en zonder telemetrie. Elke foto staat veilig op jullie eigen server."
          }
        }
      }
    },
    "landing.f3Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
