    "landing.lede": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "kinframe sends photos and videos to the family’s photo frames. No subscriptions, no tracking, and the server belongs to your family."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "kinframe stuurt foto’s en video’s naar de fotokaders van de familie. Geen abonnement, geen tracking, en de server is van jullie."
          }
        }
      }
    },
    "landing.noAuth": {
      "extractionState": "manual",
      "localizations": {
