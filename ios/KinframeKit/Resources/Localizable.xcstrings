        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared album no longer exists in iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gedeelde album bestaat niet meer in iCloud."
          }
        }
      }
