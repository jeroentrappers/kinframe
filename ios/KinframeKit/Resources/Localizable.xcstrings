    "ios.ps.albumOnlySuggest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first import adds more than {count} photos. With Only in album mode they play when the frame plays this album, without flooding the everyday slideshow."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste import voegt meer dan {count} foto’s toe. Met Alleen in albummodus spelen ze als het kader dit album speelt, zonder de gewone diavoorstelling te overspoelen."
          }
        }
      }
    },
    "ios.ps.albumSyncs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synced"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesynchroniseerd"
          }
        }
      }
    },
    "ios.ps.albumTiming": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We check the album about every half hour (iCloud: every hour)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We kijken ongeveer elk half uur in het album (iCloud: elk uur)."
          }
        }
      }
    },
    "ios.ps.apiKey": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API key"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "API-sleutel"
          }
        }
      }
    },
    "ios.ps.apiKeyHowTo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Immich, open Account settings → API keys → New API key and tick only album.read, asset.read, asset.view and asset.download."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Immich Accountinstellingen → API-sleutels → Nieuwe API-sleutel en vink alleen album.read, asset.read, asset.view en asset.download aan."
          }
        }
      }
    },
    "ios.ps.bestEffort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "best effort"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "zonder garantie"
          }
        }
      }
    },
    "ios.ps.bestEffortNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best effort: Apple offers no official way to do this. It may stop working without warning; we’ll tell you if it does."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder garantie: Apple biedt hier geen officiële manier voor. Het kan zonder waarschuwing stoppen; we laten het je weten als dat gebeurt."
          }
        }
      }
    },
    "ios.ps.bestEffortShort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud: best effort, may stop working without warning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud: zonder garantie, kan zonder waarschuwing stoppen."
          }
        }
