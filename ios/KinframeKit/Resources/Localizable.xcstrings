    "sources.icloud.bestEffort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best effort: Apple offers no official way to do this. It may stop working without warning; we’ll tell you if it does."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder garantie: Apple biedt hier geen officiële manier voor. Het kan zonder waarschuwing stoppen met werken; we laten het je dan weten."
          }
        }
      }
    },
    "sources.icloud.link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link to the shared album"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Link naar het gedeelde album"
          }
        }
      }
    },
    "sources.icloud.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your iPhone or iPad, open Photos → Albums and open the shared album."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open op je iPhone of iPad Foto’s → Albums en open het gedeelde album."
          }
        }
      }
    },
    "sources.icloud.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the people icon and turn on Public Website."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het personen-icoon en zet Openbare website aan."
          }
        }
      }
    },
    "sources.icloud.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Share Link, copy it and paste it here."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Deel link, kopieer hem en plak hem hier."
          }
        }
      }
    },
    "sources.immich.apiHowto": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the address of your Immich server and an API key. In Immich: Account settings → API keys → New API key."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul het adres van je Immich-server en een API-sleutel in. In Immich: Account settings → API keys → New API key."
          }
        }
      }
    },
