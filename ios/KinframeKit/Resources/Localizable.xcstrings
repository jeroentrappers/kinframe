    "convert.bootBrandingHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replaces the logo and animation shown during start-up. The originals are saved to your downloads first."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervangt het logo en de animatie bij het opstarten. De originelen komen eerst in je downloads."
          }
        }
      }
    },
    "convert.bootBrandingWarn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This writes to one of the frame’s start-up partitions. kinframe reads every byte back and puts the original back if anything differs, but a power cut during those seconds could stop the frame from starting. Keep it plugged in, or turn this off."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit schrijft naar een van de opstartpartities van het kader. kinframe leest elke byte terug en zet het origineel terug als er iets afwijkt, maar als de stroom net dan uitvalt, start het kader misschien niet meer op. Laat de stekker erin, of zet dit uit."
          }
        }
      }
    },
    "convert.checkTitle": {
      "extractionState": "manual",
