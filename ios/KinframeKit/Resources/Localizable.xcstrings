    "convert.prepareBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the frame to this computer with a USB cable. Denver frames are ready out of the box: there is nothing to turn on. The first time, the frame asks whether to allow this computer: tick “Always allow” and tap OK."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit het kader met een USB-kabel aan op deze computer. Denver-kaders zijn meteen klaar: je hoeft niets aan te zetten. De eerste keer vraagt het kader of het deze computer mag vertrouwen: vink “Altijd toestaan” aan en tik op OK."
          }
        }
      }
    },
    "convert.prepareHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If adb or Android Studio is running on this computer, close it first: only one program can use the frame at a time."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draait adb of Android Studio op deze computer? Sluit het dan eerst af: maar één programma tegelijk kan het kader gebruiken."
          }
        }
      }
    },
    "convert.prepareOther": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another Frameo frame? Turn on ADB access first: on the frame, open Settings → About (on some frames it is under Beta program)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ander Frameo-kader? Zet dan eerst ADB-toegang aan: open op het kader Instellingen → Over (op sommige kaders staat dat onder Bètaprogramma)."
          }
        }
      }
    },
    "convert.prepareTitle": {
