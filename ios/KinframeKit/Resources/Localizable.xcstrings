    "add.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the 8-digit code shown on the frame. A new frame shows it during setup. On a frame that’s already set up, open the menu and choose Add someone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul de code van 8 cijfers in die op het kader staat. Een nieuw kader toont ze tijdens het instellen. Op een kader dat al werkt, open je het menu en kies je Iemand toevoegen."
          }
        }
      }
    },
    "add.checking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Even kijken…"
          }
        }
      }
    },
    "add.claimedBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re the owner of this frame now. Give it a name so the family knows which one it is."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent nu de eigenaar van dit kader. Geef het een naam, zodat de familie weet welk kader het is."
          }
        }
      }
    },
    "add.claimedTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It’s yours!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is van jou!"
          }
        }
      }
    },
    "add.codeHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can paste the whole code. Spaces don’t matter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je mag de hele code plakken. Spaties maken niet uit."
          }
        }
