      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new owner can do everything, including removing the frame. Admins already manage it, so they’re usually the best choice."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De nieuwe eigenaar kan alles, ook de fotolijst verwijderen. Beheerders doen al veel, dus zij zijn meestal de beste keuze."
