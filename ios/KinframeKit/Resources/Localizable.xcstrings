    "ios.ps.err.auth_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service refused the key or password. Enter it again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dienst weigerde de sleutel of het wachtwoord. Vul het opnieuw in."
          }
        }
      }
    },
    "ios.ps.err.auth_failed.key": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Immich refused the API key. Enter it again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Immich weigerde de API-sleutel. Vul hem opnieuw in."
          }
        }
      }
    },
    "ios.ps.err.auth_failed.password": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Immich refused the link password. Enter it again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Immich weigerde het wachtwoord van de link. Vul het opnieuw in."
          }
        }
      }
    },
    "ios.ps.err.credentials_unreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stored key can’t be read any more (the server’s secret key changed). Enter it again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opgeslagen sleutel is niet meer leesbaar (de geheime sleutel van de server is veranderd). Vul hem opnieuw in."
          }
        }
      }
    },
    "ios.ps.err.disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server doesn’t offer this kind of photo source."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze server biedt dit soort fotobron niet aan."
          }
        }
      }
    },
    "ios.ps.err.duplicate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This album already syncs here."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit album synchroniseert hier al."
          }
        }
      }
    },
    "ios.ps.err.format_changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{service} answered in a way we don’t understand. This can happen because there’s no official way to do this. We’ll keep checking once a day."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "{service} antwoordde op een manier die we niet begrijpen. Dat kan gebeuren omdat er geen officiële manier voor is. We blijven één keer per dag kijken."
          }
        }
      }
    },
    "ios.ps.err.limit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are as many photo sources as allowed. Stop one first."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn al zoveel fotobronnen als toegestaan. Stop er eerst een."
          }
        }
      }
    },
    "ios.ps.err.link_expired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Immich link expired. Create a new one and paste it here."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Immich-link is verlopen. Maak een nieuwe en plak hem hier."
          }
        }
      }
    },
    "ios.ps.err.link_not_found": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link no longer works. It may have been deleted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De link werkt niet meer. Misschien is hij verwijderd."
          }
        }
      }
    },
    "ios.ps.err.link_not_found.icloud": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link no longer works. It may have been deleted, or Public Website was turned off."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De link werkt niet meer. Misschien is hij verwijderd, of is Openbare website uitgezet."
          }
        }
      }
    },
    "ios.ps.err.mass_removal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} photos disappeared from the album. Remove them here too?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er verdwenen {count} foto’s uit het album. Ook hier verwijderen?"
          }
        }
      }
    },
    "ios.ps.err.owner_lost_access": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The person who set this up can no longer manage it, so syncing stopped."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie dit instelde, kan het niet meer beheren, dus het synchroniseren is gestopt."
          }
        }
      }
    },
    "ios.ps.err.owner_lost_access.album": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} can no longer manage this album, so syncing stopped. Take it over or stop syncing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} kan dit album niet meer beheren, dus het synchroniseren is gestopt. Neem het over of stop met synchroniseren."
          }
        }
      }
    },
    "ios.ps.err.owner_lost_access.feed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} can no longer manage this family, so syncing stopped. Take it over or stop syncing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} kan deze familie niet meer beheren, dus het synchroniseren is gestopt. Neem het over of stop met synchroniseren."
          }
        }
      }
    },
    "ios.ps.err.password_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link now needs a password."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De link heeft nu een wachtwoord nodig."
          }
        }
      }
    },
    "ios.ps.err.permission_missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API key is missing a permission: it needs album.read, asset.read, asset.view and asset.download."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De API-sleutel mist een recht: hij heeft album.read, asset.read, asset.view en asset.download nodig."
          }
        }
      }
    },
    "ios.ps.err.private_address_blocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server isn’t allowed to reach addresses on a private network. Use the public address, or ask the server’s operator."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze server mag geen adressen op een privénetwerk bereiken. Gebruik het openbare adres, of vraag het aan de beheerder van de server."
          }
        }
      }
    },
    "ios.ps.err.rate_limited_upstream": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service asked us to slow down. We’ll try again later."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dienst vroeg ons trager te gaan. We proberen het later opnieuw."
          }
        }
      }
    },
    "ios.ps.err.tls_error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{host}’s certificate isn’t trusted. Check its HTTPS setup."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het certificaat van {host} wordt niet vertrouwd. Controleer de HTTPS-instellingen."
          }
        }
      }
    },
    "ios.ps.err.too_large": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This album is too big to read in one go. Use a smaller album."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit album is te groot om in één keer te lezen. Gebruik een kleiner album."
          }
        }
      }
    },
    "ios.ps.err.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong with this source."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ging iets mis met deze bron."
          }
        }
      }
    },
    "ios.ps.err.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t reach {host}. Is the server on? We keep trying."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} is niet bereikbaar. Staat de server aan? We blijven het proberen."
          }
        }
      }
    },
    "ios.ps.err.unreachable.since": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t reach {host} since {since}. We keep trying."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} is niet bereikbaar sinds {since}. We blijven het proberen."
          }
        }
      }
    },
    "ios.ps.err.unsupported_link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is an iCloud Link for a few photos, not a shared album. Share an album with Public Website on."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een iCloud-link voor enkele foto’s, geen gedeeld album. Deel een album met Openbare website aan."
          }
        }
      }
    },
    "ios.ps.err.upstream_error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} had a problem. We keep trying."
          }
        },
        "nl": {
