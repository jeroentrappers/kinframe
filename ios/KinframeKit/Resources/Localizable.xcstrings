    "add.backToFrames": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to frames"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terug naar kaders"
          }
        }
      }
    },
    "add.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the 8-digit code shown on the frame. A new frame shows it during setup. On a frame that’s already set up, open the menu and choose Add someone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul de code van 8 cijfers in die op het kader staat. Een nieuw kader toont ze tijdens het instellen. Op een kader dat al werkt, open je het menu en kies je Iemand toevoegen."
          }
        }
      }
    },
    "add.checking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Even kijken…"
          }
        }
      }
    },
    "add.claimedBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re the owner of this frame now. Give it a name so the family knows which one it is."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent nu de eigenaar van dit kader. Geef het een naam, zodat de familie weet welk kader het is."
          }
        }
      }
    },
    "add.claimedTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It’s yours!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is van jou!"
          }
        }
      }
    },
    "add.codeHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can paste the whole code. Spaces don’t matter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je mag de hele code plakken. Spaties maken niet uit."
          }
        }
      }
    },
    "add.codeHintFeeds": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 8-digit code on a frame, or a family code like KF7Q-M2XA. You can paste the whole code."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code van 8 cijfers op een kader, of een familiecode zoals KF7Q-M2XA. Je kunt de hele code plakken."
          }
        }
      }
    },
    "add.codeLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame code"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Code van het kader"
          }
        }
      }
    },
    "add.convertHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have a Denver photo frame with the Frameo app? You can turn it into a kinframe frame."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb je een Denver-fotokader met de Frameo-app? Dan kun je er een kinframe-kader van maken."
          }
        }
      }
    },
    "add.convertLink": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert a frame"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kader ombouwen"
          }
        }
      }
    },
    "add.joinedBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything you send now appears on the frame. {owner} can change what you’re allowed to do."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je nu stuurt, verschijnt op het kader. {owner} kan aanpassen wat je mag doen."
          }
        }
      }
    },
    "add.joinedTitle": {
      "extractionState": "manual",
      "localizations": {
