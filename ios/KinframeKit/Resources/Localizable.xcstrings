    "sources.err.credentials_unreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stored link or key can’t be read any more (the server’s secret key changed). Enter it again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bewaarde link of sleutel is niet meer leesbaar (de geheime sleutel van de server is veranderd). Vul hem opnieuw in."
          }
        }
      }
    },
    "sources.err.format_changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{service} answered in a way we don’t understand. Check that the server is up to date."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "{service} gaf een antwoord dat we niet begrijpen. Controleer of de server up-to-date is."
