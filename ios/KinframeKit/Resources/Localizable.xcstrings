    "storefront.step1Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Children, grandchildren and friends send photos and videos with the app or from the browser, wherever they are."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinderen, kleinkinderen en vrienden sturen foto’s en video’s met de app of vanuit de browser, waar ze ook zijn."
          }
        }
      }
    },
    "storefront.step1Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send from your phone"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur vanaf je smartphone"
          }
        }
      }
    },
    "storefront.step2Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo appears right away. You see when it has arrived, and a reaction from the frame comes straight back to you."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De foto verschijnt meteen. Je ziet wanneer hij is aangekomen, en een reactie van het kader komt meteen bij jou terug."
          }
        }
      }
    },
    "storefront.step2Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the frame in seconds"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Binnen enkele seconden op het kader"
          }
        }
      }
    },
    "storefront.step3Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No monthly costs and nothing to unlock. Calendars, videos and every update are included."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen maandelijkse kosten en niets om te ontgrendelen. Agenda’s, video’s en elke update zijn inbegrepen."
          }
        }
      }
    },
    "storefront.step3Title": {
      "extractionState": "manual",
