    "landing.f1Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop photos and videos here or share them from your phone. They show up on the frame a few seconds later."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep foto’s en video’s hierheen of deel ze vanaf je gsm. Enkele seconden later staan ze op het kader."
          }
        }
      }
    },
    "landing.f1Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send from anywhere"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van overal sturen"
          }
        }
      }
    },
    "landing.f2Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can see when a photo arrives and when it’s been seen. Reactions from the frame come right back to you."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ziet wanneer een foto aankomt en wanneer hij bekeken is. Reacties van het kader komen meteen bij jou terug."
          }
        }
      }
    },
    "landing.f2Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the smile"
          }
